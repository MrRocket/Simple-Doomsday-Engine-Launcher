<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Simple_Doomsday_Engine_Launcher.ConfirmDialog"
        Width="350" Height="175"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Update">




    <StackPanel Margin="10" Spacing="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Yes" Name="YesButton" Width="70"/>
            <Button Content="No" Name="NoButton" Width="70"/>
        

           
        

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">



         </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>

